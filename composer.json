{
  "name": "monkeyscloud/monkeyslegion-permissions",
  "description": "Enterprise RBAC and ABAC authorization engine for MonkeysLegion",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "authorization",
    "rbac",
    "abac",
    "permissions",
    "policies",
    "monkeyslegion",
    "security"
  ],
  "authors": [
    {
      "name": "MonkeysCloud",
      "email": "jorge@monkeys.cloud"
    }
  ],
  "homepage": "https://monkeyslegion.com/docs/packages/permissions",
  "require": {
    "php": "^8.4",
    "monkeyscloud/monkeyslegion-core": "*",
    "monkeyscloud/monkeyslegion-di": "*",
    "monkeyscloud/monkeyslegion-auth": "*",
    "monkeyscloud/monkeyslegion-entity": "*",
    "monkeyscloud/monkeyslegion-cache": "*",
    "monkeyscloud/monkeyslegion-database": "*",
    "monkeyscloud/monkeyslegion-events": "*",
    "monkeyscloud/monkeyslegion-http": "*",
    "psr/http-message": "^2.0",
    "psr/http-server-middleware": "^1.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0",
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "suggest": {
    "monkeyscloud/monkeyslegion-tenancy": "For automatic tenant resolution",
    "monkeyscloud/monkeyslegion-telemetry": "For authorization audit tracing",
    "monkeyscloud/monkeyslegion-apex": "For AI-backed fuzzy policies"
  },
  "autoload": {
    "psr-4": {
      "MonkeysLegion\\Permissions\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MonkeysLegion\\Permissions\\Tests\\": "tests/"
    }
  },
  "extra": {
    "monkeyslegion": {
      "providers": [
        "MonkeysLegion\\Permissions\\Provider\\PermissionsProvider"
      ]
    }
  }
}
